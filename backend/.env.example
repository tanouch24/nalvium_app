# Copier vers backend/.env (JAMAIS commité). Toutes les variables ont le préfixe NALVIUM_.
# Aucune valeur ci-dessous n'est un secret : renseignez les vraies valeurs uniquement sur la machine/serveur concerné.

# development | production  (production : docs OpenAPI désactivées, identifiants de dev refusés)
NALVIUM_ENV=development
# Hébergeur : DATABASE_URL (postgresql://…) est aussi acceptée et complétée pour psycopg.
NALVIUM_DATABASE_URL=postgresql+psycopg://nalvium:nalvium_dev@localhost:5433/nalvium

# --- IA (serveur uniquement : la clé n'est JAMAIS dans l'application) ---
# openai | none (none = aucune IA, utile en test)
NALVIUM_AI_PROVIDER=none
# NALVIUM_OPENAI_API_KEY=
# NALVIUM_OPENAI_MODEL=
# NALVIUM_OPENAI_REASONING_EFFORT=low
# NALVIUM_OPENAI_TIMEOUT_S=60

# --- Médias ---
# Production : chemin ABSOLU d'un volume persistant (ex. /data/media), sinon le démarrage est refusé.
NALVIUM_MEDIA_ROOT=./var/media
# NALVIUM_MAX_UPLOAD_BYTES=12582912
# NALVIUM_MAX_VIDEO_BYTES=31457280
# NALVIUM_MAX_VIDEO_SECONDS=16
# NALVIUM_VIDEO_FRAMES_MAX=6

# --- Notification interne Telegram : OPTIONNELLE. Absent = « non configurée » (aucun envoi). ---
# Procédure : docs/TELEGRAM_SETUP.md. Ne jamais commiter ces valeurs.
# NALVIUM_TELEGRAM_BOT_TOKEN=
# NALVIUM_TELEGRAM_CHAT_ID=
# NALVIUM_TELEGRAM_TIMEOUT_S=5

# --- Limites d'abus (mémoire du processus) ---
# NALVIUM_RATE_LIMIT_ENABLED=true

# --- Rétention / nettoyage (voir docs/RETENTION.md) ---
# NALVIUM_RETENTION_DRAFT_REQUEST_DAYS=14
# NALVIUM_RETENTION_TEMP_PHOTO_HOURS=48
# NALVIUM_RETENTION_COMMUNITY_DRAFT_HOURS=24
# NALVIUM_RETENTION_ORPHAN_FILE_HOURS=48
# NALVIUM_CLEANUP_BATCH_LIMIT=500
